---
import { marked } from 'marked';
import { type Card } from 'types';
import Action from '@components/Action.astro';
import Badge from '@components/Badge.astro';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends Card {
    class?: string;
    /** Reserves two lines of height for the heading (so cards with a one-line and a
     * two-line heading still line up) and renders it as an h4 instead of an h3. Opt-in
     * per section, not a general Card behaviour — see `compactTiles` on cardsSection. */
    compactTiles?: boolean;
    /** Drops the card's own max-w-2xl cap so it fills its container instead — for a
     * single stacked column (cardsSection `columns: 'one'`) where the cards are meant
     * to run wide, rather than the narrower width that suits a multi-column grid. */
    fullWidth?: boolean;
}

const { badge, heading, body, cta, image, theme, textAlign, hasBorder, compactTiles, fullWidth, class: className } =
    Astro.props;
const HeadingTag = compactTiles ? 'h4' : 'h3';

// A "before → after" heading (e.g. "Systemic vulnerability → Infrastructural resilience")
// gets its lead-in half colored the same red as `.text-accent-red`/`.card-accent-red`,
// so the reader's eye lands on the problem before the arrow carries it to the fix.
// Plain headings (no ' → ') render unchanged.
const arrowParts = heading?.split(' → ');
const headingHasArrow = arrowParts?.length === 2;

// 'light'/'dark' are full daisyUI themes, applied via `data-theme` (same mechanism as
// Section's theme). 'primary'/'secondary' aren't themes — there's no daisyUI theme named
// either — they're the same fixed color-role treatment `.btn-primary`/`.btn-secondary` use
// (see globals.css), applied here as `.card-primary`/`.card-secondary` instead. The three
// 'accent-*' values are the same idea again, but only a colored top border — background/text
// stay whatever the ambient section theme gives them. 'transparent' (or unset) gets none of
// these, so the card just inherits its ambient section's theme untouched.
const isFullTheme = theme === 'light' || theme === 'dark';

// Center-aligned cards keep the old treatment — a full-width figure banner above the
// body. Left-aligned cards (e.g. the org logos on "Who's behind this") instead get the
// image as a small mark next to the heading, since a banner doesn't read well beside
// left-aligned text.
const hasImage = image && image.src;
const showTopFigure = hasImage && textAlign === 'center';
const showInlineLogo = hasImage && textAlign !== 'center';
---

<div
    class:list={[
        'card',
        hasBorder !== false && 'card-border',
        fullWidth ? 'w-full' : 'w-full max-w-2xl',
        theme === 'primary' && 'card-primary',
        theme === 'secondary' && 'card-secondary',
        theme === 'third-card-bone' && 'card-third-bone',
        theme === 'accent-blue' && 'card-accent-blue',
        theme === 'accent-green' && 'card-accent-green',
        theme === 'accent-yellow' && 'card-accent-yellow',
        theme === 'accent-red' && 'card-accent-red',
        className
    ]}
    {...isFullTheme && { 'data-theme': theme }}
>
    {
        showTopFigure && (
            <figure>
                <ResponsiveImage _id={image._id} src={image.src} width={image.dimensions?.width} height={image.dimensions?.height} alt={image.alt} />
            </figure>
        )
    }
    <div
        class:list={[
            'card-body gap-4',
            textAlign === 'center' ? 'items-center text-center' : 'text-left',
            // These heading-only cards (no body/cta/badge) just carry a short
            // "before → after" phrase — daisyUI's default 1.5rem card padding is
            // sized for a fuller card (heading + paragraph + actions) and reads as
            // empty margin around one or two short lines of text.
            headingHasArrow && '!p-4'
        ]}
    >
        {badge && badge.label && <Badge {...badge} />}
        {
            (heading || showInlineLogo) && (
                <div class:list={['flex items-center gap-3', showInlineLogo && 'justify-between']}>
                    {
                        heading && (
                            <HeadingTag
                                class:list={[
                                    'font-black card-title text-balance',
                                    // compactTiles cards (the org-logo tiles) and "before → after"
                                    // headings both run a size step down from the default
                                    // sm:text-2xl — the former shares its row with a logo, the
                                    // latter reads better smaller regardless of column count.
                                    compactTiles || headingHasArrow ? 'text-base sm:text-lg' : 'sm:text-2xl',
                                    // Reserves three lines (the longest heading in this set needs all
                                    // three) rather than matching each heading's own line count — no
                                    // font size makes every heading wrap to the same number of lines
                                    // (their word lengths vary too much), so shorter headings vertically
                                    // centre in the extra space instead. em-based, not a fixed rem value,
                                    // so it still reserves exactly three lines whatever the active
                                    // breakpoint's font size is.
                                    compactTiles && 'leading-tight min-h-[3.75em]'
                                ]}
                            >
                                {headingHasArrow ? (
                                    // Three separate blocks (before/arrow/after), not one run of
                                    // inline text — at narrow widths a single wrapped heading let
                                    // the arrow land mid-phrase (e.g. after "vulnerability" wraps
                                    // to its own line), stranding it between unrelated line breaks
                                    // instead of cleanly separating the two phrases.
                                    //
                                    // Row-vs-column is decided by whether "before → after" actually
                                    // fits on one line at this card's own width (see the script
                                    // below), not a fixed viewport breakpoint — the three phrases
                                    // vary a lot in length, so a fixed cutoff either stacks phrases
                                    // short enough to share a line, or crams long ones that don't
                                    // fit. Starts stacked (always safe, never overflows) and the
                                    // script upgrades to a row once it measures room for one; the
                                    // arrow rotates to point down while stacked, right in a row.
                                    <span class="arrow-heading" data-arrow-heading>
                                        <span class="text-accent-red">{arrowParts[0]}</span>
                                        <span aria-hidden="true" class="arrow-heading-glyph">
                                            →
                                        </span>
                                        <span>{arrowParts[1]}</span>
                                    </span>
                                ) : (
                                    heading
                                )}
                            </HeadingTag>
                        )
                    }
                    {
                        showInlineLogo && (
                            // Explicit 64px source rather than the asset's own (much larger)
                            // dimensions, so Astro emits a small file for a ~32px mark — see
                            // the same pattern on Header's logo.
                            <ResponsiveImage
                                _id={image._id}
                                src={image.src}
                                width={64}
                                height={64}
                                alt={image.alt}
                                class="object-contain w-8 h-8 shrink-0"
                            />
                        )
                    }
                </div>
            )
        }
        {body && <div class="markdown" set:html={marked.parse(body)} />}
        {
            cta && cta.length > 0 && (
                <div class="card-actions items-center">
                    {cta.map((item) => (
                        <Action
                            action={item}
                            class:list={[item._type === 'actionLink' ? 'link-underline' : 'px-4 py-2.5 h-auto min-h-0']}
                        />
                    ))}
                </div>
            )
        }
    </div>
</div>

<style>
    /* Safe default (no JS, or before the script below runs): stacked, arrow
       pointing down — this never overflows, regardless of phrase length or card
       width. `.is-row` is only ever added once the script has actually measured
       that the row fits. */
    .arrow-heading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }
    .arrow-heading.is-row {
        flex-direction: row;
        align-items: baseline;
        gap: 0.5rem;
    }
    .arrow-heading.is-row span {
        white-space: nowrap;
    }
    /* Single glyph, rotated — rather than swapping in a second arrow character —
       so pointing down (stacked) vs. right (row) is one property, not two glyphs
       kept in sync. */
    .arrow-heading-glyph {
        display: inline-block;
        transform: rotate(90deg);
    }
    .arrow-heading.is-row .arrow-heading-glyph {
        transform: none;
    }
</style>

<script>
    // Row-vs-column for `.arrow-heading` is decided by whether "before → after"
    // actually fits on one line, not a fixed viewport breakpoint — see the comment
    // above `.arrow-heading` in Card.astro. Cards sharing a section (e.g. the three
    // "why" cards on the paper page) are grouped and switch together, all-or-nothing:
    // if even the longest phrase in the group wouldn't fit, none of them go to a
    // row, so siblings never mismatch (one in a row, another still stacked).
    function syncArrowHeadings() {
        const elements = [...document.querySelectorAll('[data-arrow-heading]')].filter((el) => !el.dataset.arrowHeadingReady);
        if (!elements.length) return;
        elements.forEach((el) => (el.dataset.arrowHeadingReady = 'true'));

        const groups = new Map();
        elements.forEach((el) => {
            // Cards sharing a section are siblings under the same grid/list
            // container — grouping by that container (rather than, say, the whole
            // page) keeps unrelated Cards sections elsewhere syncing independently.
            const groupKey = el.closest('.card')?.parentElement;
            if (!groupKey) return;
            if (!groups.has(groupKey)) groups.set(groupKey, []);
            groups.get(groupKey).push(el);
        });

        groups.forEach((group) => {
            // Each phrase's own natural (single-line, unwrapped) width — measured
            // once by briefly switching every member to a row, since it depends
            // only on text/font, never on how much room is currently available.
            group.forEach((el) => el.classList.add('is-row'));
            const naturalWidths = group.map((el) => el.scrollWidth);

            const sync = () => {
                const fitsAll = group.every((el, i) => {
                    const cardBody = el.closest('.card-body');
                    const style = getComputedStyle(cardBody);
                    const available = cardBody.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
                    return naturalWidths[i] <= available;
                });
                group.forEach((el) => el.classList.toggle('is-row', fitsAll));
            };
            sync();
            const resizeObserver = new ResizeObserver(sync);
            group.forEach((el) => resizeObserver.observe(el.closest('.card-body')));
        });
    }
    syncArrowHeadings();
    document.addEventListener('astro:after-swap', syncArrowHeadings);
</script>
