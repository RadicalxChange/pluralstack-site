---
import { marked } from 'marked';
import { type HeroSection } from 'types';
import Action from '@components/Action.astro';
import Card from '@components/Card.astro';
import Section from '@components/Section.astro';

interface Props extends HeroSection {}

const { heading, subheading, body, cta, outro, items, columns, sketch, headingLevel, ...rest } = Astro.props;
const HeadingTag = headingLevel || 'h1';
---

<Section {...rest} class="text-left !py-16 sm:!py-24">
    {
        heading && (
            <HeadingTag class="text-[1.594rem] font-black sm:text-[2.55rem] text-balance">
                {heading.split('\n').map((line, i) => (
                    <Fragment>
                        {i > 0 && <br />}
                        {line}
                    </Fragment>
                ))}
            </HeadingTag>
        )
    }
    {
        subheading && (
            <h2 class:list={[heading && 'mt-4', 'text-xl font-bold sm:text-3xl text-balance opacity-80']}>
                {subheading}
            </h2>
        )
    }
    {body && <div class:list={[(heading || subheading) && 'mt-6', 'max-w-prose markdown']} set:html={marked.parse(body)} />}
    {
        cta && cta.length > 0 && (
            <div class:list={[(heading || body) && 'mt-8', 'flex flex-wrap items-center justify-start gap-4 hero-ctas']}>
                {cta.map((item) => (
                    <Action
                        action={item}
                        class:list={[item._type === 'actionLink' && 'link-underline']}
                    />
                ))}
            </div>
        )
    }
    {
        items && items.length > 0 && (
            // Left-justified (not centred, unlike Cards.astro's standalone grid) to match
            // the hero's own left-aligned text and CTAs — this is the same items grid moved
            // in from a separate CardsSection, now living inside the hero itself.
            <div class:list={[(heading || body || (cta && cta.length > 0)) && 'mt-8', 'flex flex-wrap justify-start gap-8']}>
                {items.map((item) => (
                    <Card
                        {...item}
                        class:list={[
                            columns === 'one'
                                ? 'basis-full'
                                : columns === 'three'
                                  ? 'basis-full md:basis-[calc(33.333%-1.334rem)]'
                                  : 'basis-full md:basis-[calc(50%-1rem)]'
                        ]}
                    />
                ))}
            </div>
        )
    }
    {outro && <div class="mt-6 text-sm opacity-70 max-w-prose markdown" set:html={marked.parse(outro)} />}
    {
        // p5 grid sketch (variant chosen by the `sketch` field), 30% opacity, in Section's
        // right-panel slot — full-bleed behind the text column (see Section.astro),
        // transparent canvas, graphic anchored to the right side. Purely decorative: no
        // pointer-events set here, so it never intercepts clicks meant for the CTAs above.
        sketch && (
            <Fragment slot="right-panel">
                <div id="hero-sketch" class="hidden w-full h-full opacity-30 sm:block" data-sketch={sketch} />
                <script>
                    const container = document.getElementById('hero-sketch');
                    if (container) {
                        // Purely decorative and tuned for the two-column desktop layout (see
                        // ANCHOR_X_FRAC in gridSketch.js) — below `sm` the hero collapses to a
                        // single text column with no room for it, so p5 and the sketch modules
                        // are dynamically imported only once the viewport actually matches,
                        // rather than shipping/parsing that JS on every mobile page load.
                        const mq = window.matchMedia('(min-width: 640px)');
                        let instance = null;
                        let observer = null;

                        const teardown = () => {
                            observer?.disconnect();
                            observer = null;
                            instance?.remove();
                            instance = null;
                        };

                        const setup = async () => {
                            if (instance) return;
                            const [{ default: p5 }, { gridSketch }, { gridSketchMark }] = await Promise.all([
                                import('p5'),
                                import('@scripts/gridSketch'),
                                import('@scripts/gridSketchMark')
                            ]);

                            // "Squares" reacts to proximity to the hero's own CTAs (`.hero-ctas`,
                            // a sibling of this canvas's wrapper under the same <section> — see
                            // Section.astro) plus the nav bar's CTA (`.nav-bar .btn`, see
                            // Header.astro). `isVisible` skips whichever nav rendering (desktop
                            // bar vs. mobile panel) isn't actually on screen at the current
                            // breakpoint/menu state — both exist in the DOM at once, but a
                            // `display:none` or `visibility:hidden` copy would otherwise still
                            // report a stale rect.
                            const isVisible = (el) => {
                                const style = getComputedStyle(el);
                                if (style.visibility === 'hidden' || style.display === 'none') return false;
                                const rect = el.getBoundingClientRect();
                                return rect.width > 0 && rect.height > 0;
                            };
                            const getInfluenceRects = () =>
                                [...document.querySelectorAll('.hero-ctas > *, .nav-bar .btn')].filter(isVisible).map((el) => el.getBoundingClientRect());

                            // "Mark" reacts to mouseY against a vertical axis twice the hero's
                            // own height, centered on the hero's vertical midpoint — since a
                            // page using this variant may have too few (or no) CTAs for
                            // CTA-proximity to read well. The container already fills the
                            // <section> exactly (see Section.astro's right-panel slot), so its
                            // own rect is the hero's rect.
                            const getAxis = () => {
                                const rect = container.getBoundingClientRect();
                                return { centerY: rect.top + rect.height / 2, halfHeight: rect.height };
                            };

                            // Which sketch variant to draw, and which of the two dependencies
                            // above it gets — see the `sketch` field on heroSection.ts. Falls
                            // back to "Squares" for any unrecognised/legacy value.
                            const sketchRunners = {
                                squares: (p) => gridSketch(p, container, getInfluenceRects),
                                mark: (p) => gridSketchMark(p, container, getAxis)
                            };
                            const runSketch = sketchRunners[container.dataset.sketch] || sketchRunners.squares;

                            // Guards against a transient 0×0 layout on first paint — calling
                            // `createCanvas(0, 0)` is a mistake p5 never recovers from even once
                            // the container gets its real size. Deferring the initial
                            // `new p5(...)` to the first non-zero size (rather than firing it
                            // eagerly and relying on `updateSize()` to fix it up after the fact)
                            // sidesteps that.
                            observer = new ResizeObserver((entries) => {
                                const { width, height } = entries[0].contentRect;
                                if (width === 0 || height === 0) return;
                                if (instance) {
                                    instance.updateSize();
                                } else {
                                    instance = new p5(runSketch, container);
                                }
                            });
                            observer.observe(container);
                        };

                        // Covers not just the initial load but also crossing the breakpoint
                        // afterwards — e.g. rotating a phone to landscape, or resizing a
                        // desktop window down past it and back up.
                        const sync = () => (mq.matches ? setup() : teardown());
                        sync();
                        mq.addEventListener('change', sync);
                    }
                </script>
            </Fragment>
        )
    }
</Section>

<style>
    /*
     * The "mark" sketch (gridSketchMark.js) still draws white squares — DIFFERENCE
     * blend mode is what makes overlapping squares flip white<->black, and swapping
     * the fill color to black directly would break that flip (black-difference-black
     * stays black, losing the pattern entirely). Inverting the rendered colors here
     * instead keeps the sketch's own drawing logic untouched: white becomes black,
     * the flip-pattern's black accents become white, and fully-transparent pixels are
     * unaffected (`invert()` only touches RGB, not alpha). Scoped to `mark` only — the
     * "squares" variant (/home/) is unaffected.
     */
    [data-sketch='mark'] {
        filter: invert(1);
    }
</style>
