---
import { marked } from 'marked';
import { type FormSection } from 'types';
import Section from '@components/Section.astro';

interface Props extends FormSection {}

const { heading, body, fields, submitLabel, formName, isConnected, notConnectedNotice, headingLevel, ...rest } = Astro.props;
const HeadingTag = headingLevel || 'h2';

// Until a form backend is chosen, the form renders disabled and posts nowhere. See
// `isConnected` in studio/schemaTypes/formSection.ts.
const isDisabled = !isConnected;

// Netlify Forms: its build bot provisions an endpoint by scanning the *built* static
// HTML for a <form data-netlify="true" name="...">, which this component renders as
// long as `formName` is set — independent of `isConnected`/`isDisabled` above, so the
// endpoint exists in Netlify (ready for its Notifications to be configured) even before
// the form goes live for real visitors. The hidden `form-name` input is Netlify's own
// documented belt-and-braces for framework-rendered forms. `bot-field` is Netlify's
// built-in honeypot — a field real visitors never see or fill in, but simple spam bots
// often do; Netlify silently drops any submission where it's non-empty.
const isNetlifyForm = Boolean(formName);
---

<Section {...rest}>
    <div class="max-w-xl mx-auto">
        {
            heading && (
                <HeadingTag class="text-2xl font-black sm:text-4xl text-balance">
                    {heading}
                </HeadingTag>
            )
        }
        {body && <div class:list={[heading && 'mt-4', 'max-w-prose markdown']} set:html={marked.parse(body)} />}
        {
            fields && fields.length > 0 && (
                <form
                    class="mt-8 space-y-4"
                    inert={isDisabled}
                    method={isNetlifyForm ? 'POST' : undefined}
                    name={formName}
                    data-netlify={isNetlifyForm ? 'true' : undefined}
                    data-netlify-honeypot={isNetlifyForm ? 'bot-field' : undefined}
                >
                    {isNetlifyForm && <input type="hidden" name="form-name" value={formName} />}
                    {
                        isNetlifyForm && (
                            <p class="hidden">
                                <label>
                                    Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
                                </label>
                            </p>
                        )
                    }
                    {fields.map((field) => (
                        <div class="w-full">
                            {field.type === 'checkbox' ? (
                                <label class="flex items-start gap-3" for={field.name}>
                                    <input
                                        class="mt-1 checkbox"
                                        id={field.name}
                                        name={field.name}
                                        type="checkbox"
                                        required={field.isRequired}
                                        disabled={isDisabled}
                                    />
                                    <span>
                                        {field.label}
                                        {field.isRequired && <span aria-hidden="true"> *</span>}
                                    </span>
                                </label>
                            ) : (
                                <>
                            <label class="block mb-1.5 font-medium" for={field.name}>
                                {field.label}
                                {field.isRequired && <span aria-hidden="true"> *</span>}
                            </label>
                            {field.type === 'textarea' ? (
                                <textarea
                                    class="w-full textarea"
                                    id={field.name}
                                    name={field.name}
                                    rows="4"
                                    required={field.isRequired}
                                    disabled={isDisabled}
                                />
                            ) : field.type === 'select' ? (
                                <select class="w-full select" id={field.name} name={field.name} required={field.isRequired} disabled={isDisabled}>
                                    <option value="">Please choose…</option>
                                    {field.options?.map((option) => (
                                        <option value={option}>{option}</option>
                                    ))}
                                </select>
                            ) : (
                                <input
                                    class="w-full input"
                                    id={field.name}
                                    name={field.name}
                                    type={field.type === 'email' ? 'email' : 'text'}
                                    required={field.isRequired}
                                    disabled={isDisabled}
                                />
                            )}
                                </>
                            )}
                        </div>
                    ))}
                    <div class="pt-2">
                        <button class="btn btn-primary" type="submit" disabled={isDisabled}>
                            {submitLabel || 'Submit'}
                        </button>
                    </div>
                </form>
            )
        }
        {isDisabled && notConnectedNotice && <p class="mt-4 text-sm opacity-60">{notConnectedNotice}</p>}
    </div>
</Section>
