---
import { type ActionLink } from 'types';

interface Props extends ActionLink {
    class?: string;
}

const { label, ariaLabel, url, bold, newTab, class: className } = Astro.props;
---

{
    url ? (
        <a class:list={['text-neutral', bold && 'font-bold', className]} href={url} aria-label={ariaLabel} {...newTab && { target: '_blank', rel: 'noopener noreferrer' }}>
            <span>{label}</span>
        </a>
    ) : (
        <button class:list={['text-neutral', bold && 'font-bold', className]} aria-label={ariaLabel}>
            <span>{label}</span>
        </button>
    )
}
